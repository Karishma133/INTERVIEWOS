PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/interviewos
JWT_SECRET=change_this_to_a_long_random_string
CODE_TIMEOUT_MS=3000
CLIENT_URL=http://localhost:3000

# Email (optional) — for Forgot Password reset links.
# Leave blank and the reset link is returned directly in the API response
# instead (dev-mode fallback), so the feature still works without setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Optional "enterprise" execution path — genuinely isolated Docker
# containers instead of a raw child process. Requires Docker Desktop
# installed AND running on this machine. Leave as false (or unset) to
# use the always-available child_process sandbox — nothing else changes.
USE_DOCKER_SANDBOX=false
